  agent: {fileID: 1995236730}
  NPC: {fileID: 1182215786}
  dialogue:
  - 'Agent: Greetings, My name is Nathan and I am from the Ministry of Human Resources'
  - 'Nurse: Hi Mr. Nathan, my name is Jane. You wanted to do your inspections again?'
  - 'Agent: Absolutely! Just to verify, what qualified you to be the nurse for this
    hospital?'
  - 'Nurse: I graduated with a bachelor''s degree in nursey and have been pusuring
    studying for a master''s degree'
  - 'Agent: I see... And how do you manage your time here?'
  - 'Nurse: I work in my timeshifts. I have set up my scheudule perfectly for me'
  - 'Agent: And how is your salary looking?'
  - 'Nurse: It is really great for me! I''m making around $5k/month given that I''m
    working part time'
  - 'Agent: I appreciate your time, thank you'
  interact: {fileID: 1921074774}
  UI: {fileID: 1735747466}
  textI: 0
