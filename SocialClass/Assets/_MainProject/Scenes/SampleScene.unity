  m_Name: 
  m_EditorClassIdentifier: 
  agent: {fileID: 381823536}
  NPC: {fileID: 478857965}
  dialogue:
  - 'Agent: (mumbles to self) Oh poor Edward...'
  - 'Janitor: Hi, can I help you sir?'
  - 'Agent: I am Nathan from the Ministry of Human Resources and have a couple of
    questions for you..'
  - 'Janitor: I am listening...'
  - 'Agent: Could you inform me with your latest level of education?'
  - 'Janitor: I graduated from high school... While I tried to study in college,
    I couldn''t...'
  - 'Agnet: And why is that?'
  - 'Janitor: I don''t have enough funds, so I''m trying my best to work these low-level
    jobs'
  - 'Agent: I''m sorry to hear that... Are you able to sustain yourself though?'
  - 'Janitor: No... It feels like I''m barely surviving... but I''ve got a plan to
    pursue education to free myself from this'
  - 'Agent: Thank you for your time... Wish you the best of luck...'
  interact: {fileID: 2011186431}
  UI: {fileID: 1189762167}
  textI: 0
